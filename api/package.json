{
  "name": "wedding-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "codes": "node scripts/generate-codes.mjs",
    "db:local": "wrangler d1 execute wedding --local --file=../db/schema.sql",
    "db:seed": "wrangler d1 execute wedding --local --file=../db/seed.sql",
    "db:reset": "npm run db:local && npm run db:seed",
    "db:remote": "wrangler d1 execute wedding --remote --file=../db/schema.sql",
    "rsvps": "wrangler d1 execute wedding --local --command \"SELECT * FROM rsvp_summary\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "~5.6.0",
    "wrangler": "^3.95.0"
  }
}
